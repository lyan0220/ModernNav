# Cloudflare Pages Functions configuration template.
#
# Copy this file to wrangler.toml and fill in your own database id:
#   cp wrangler.toml.example wrangler.toml
#   npx wrangler d1 create modern-nav-db
#   -> paste the returned database_id below
#
# wrangler.toml itself is gitignored because it contains your real database id.

name = "modernnav"
compatibility_date = "2024-01-01"

[[d1_databases]]
binding = "DB"
database_name = "modern-nav-db"
database_id = "<your-d1-database-id>"
